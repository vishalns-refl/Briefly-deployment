{
  "buildCommand": "mkdir -p public && echo 'OK' > public/index.html",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ping",
      "schedule": "0 5 * * *"
    }
  ]
}
